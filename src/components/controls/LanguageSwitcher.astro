---
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import FloatingButton from "@/components/common/FloatingButton.astro";

/**
 * LanguageSwitcher - 语言切换器（简体中文 / English）
 * 挂在右下角悬浮坞，与亮暗模式切换同款交互：
 * 点击按钮弹出面板，选择后即兴替换界面文案，偏好存 localStorage。
 */
---

<div class="dock-item">
    <FloatingButton
        id="lang-switch"
        icon="material-symbols:translate"
        ariaLabel="语言 / Language"
        title="语言 / Language"
    />
    <div
        id="lang-panel"
        class="float-panel float-panel-closed absolute transition-all right-0 p-2 w-44"
        role="menu"
        aria-labelledby="lang-switch"
        data-floating-panel
        data-floating-panel-trigger="lang-switch"
        inert
        aria-hidden="true"
    >
        <DropdownItem class="lang-option" isActive={false} isLast={false}>
            <span class="lang-option-inner" data-lang-option="zh_CN">
                <Icon name="material-symbols:language" class="text-[1.25rem] mr-3"></Icon>
                简体中文
            </span>
        </DropdownItem>
        <DropdownItem class="lang-option" isActive={false} isLast={true}>
            <span class="lang-option-inner" data-lang-option="en">
                <Icon name="material-symbols:language" class="text-[1.25rem] mr-3"></Icon>
                English
            </span>
        </DropdownItem>
    </div>
</div>

<script>
import {
	applyLang,
	getStoredLang,
	setStoredLang,
	type SiteLang,
} from "@/utils/i18n-client";

/** 切换浮动面板的开合（class 变化由 floating-panel-utils 同步 inert / aria） */
function toggleFloatingPanel(id: string): void {
	document.getElementById(id)?.classList.toggle("float-panel-closed");
}

/** 同步两个语言选项的选中态 */
function syncLangUI(): void {
	const current = getStoredLang();
	document.querySelectorAll("[data-lang-option]").forEach((el) => {
		const isActive = el.getAttribute("data-lang-option") === current;
		el.closest(".lang-option")?.classList.toggle("current-theme-btn", isActive);
	});
}

function switchLang(lang: SiteLang): void {
	setStoredLang(lang);
	void applyLang(lang, true);
	syncLangUI();
}

/** 首次加载 + Swup 切页后按存储语言应用（切页插入的新内容是中文，需强制重扫） */
function reapplyStoredLang(): void {
	void applyLang(getStoredLang(), true);
	syncLangUI();
}

function initLanguageSwitcher(): void {
	document.getElementById("lang-switch")?.addEventListener("click", () => {
		syncLangUI();
		toggleFloatingPanel("lang-panel");
	});

	document.querySelectorAll("[data-lang-option]").forEach((el) => {
		el.addEventListener("click", () => {
			const lang = el.getAttribute("data-lang-option") as SiteLang;
			switchLang(lang);
			toggleFloatingPanel("lang-panel");
		});
	});

	reapplyStoredLang();
}

initLanguageSwitcher();
document.addEventListener("astro:page-load", reapplyStoredLang);
document.addEventListener("swup:contentReplaced", reapplyStoredLang);
</script>

<style>
/* 语言选项：让整行可点（DropdownItem 内再包了一层 span） */
:global(.lang-option) {
    cursor: pointer;
}
</style>
