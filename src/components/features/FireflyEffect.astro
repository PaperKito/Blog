<script>
	console.log("[Firefly] module executing");
	import { fireflyConfig } from "@/config";
	import type { FireflyConfig } from "@/types/effectsConfig";

	type Firefly = {
		x: number;
		y: number;
		r: number;
		alpha: number;
		baseAlpha: number;

		vx: number;
		vy: number;
		phase: number;
		twinkleSpeed: number;
		swayAmp: number;
		swayPhase: number;
	};

	const rand = (min: number, max: number) => min + Math.random() * (max - min);

	function createFirefly(w: number, h: number, cfg: FireflyConfig): Firefly {
	const angle = Math.random() * Math.PI * 2;
	const speed = rand(cfg.speed.drift.min, cfg.speed.drift.max) * (Math.random() > 0.5 ? 1 : 0.6);
	return {
		x: Math.random() * w,
		y: Math.random() * h,
		r: rand(cfg.size.min, cfg.size.max),
		baseAlpha: rand(cfg.opacity.min, cfg.opacity.max),
		alpha: 0,
		vx: Math.cos(angle) * speed,
		vy: Math.sin(angle) * speed - speed * 0.25,
		phase: Math.random() * Math.PI * 2,
		twinkleSpeed: rand(cfg.speed.twinkle * 0.6, cfg.speed.twinkle * 1.4),
		swayAmp: rand(6, 22),
		swayPhase: Math.random() * Math.PI * 2,
	};
}

class FireflyEffect {
	private canvas: HTMLCanvasElement | null = null;
	private ctx: CanvasRenderingContext2D | null = null;
	private flies: Firefly[] = [];
	private rafId: number | null = null;
	private lastTime = 0;
	private elapsed = 0;
	private running = false;
	private reducedMotion = false;

	constructor(private config: FireflyConfig) {
		this.reducedMotion = window.matchMedia?.(
			"(prefers-reduced-motion: reduce)",
		).matches;
	}

	private get width() {
		return window.innerWidth;
	}
	private get height() {
		return window.innerHeight;
	}

	start() {
		if (this.running || !this.config.enable) return;
		this.running = true;

		this.canvas = document.createElement("canvas");
		this.canvas.width = this.width;
		this.canvas.height = this.height;
		this.canvas.id = "canvas_firefly";
		this.canvas.setAttribute(
			"style",
			`position: fixed; left: 0; top: 0; pointer-events: none; z-index: ${this.config.zIndex}; transform: translateZ(0);`,
		);
		document.body.appendChild(this.canvas);
		this.ctx = this.canvas.getContext("2d");

		this.flies = Array.from({ length: this.config.num }, () =>
			createFirefly(this.width, this.height, this.config),
		);

		window.addEventListener("resize", this.handleResize);

		if (this.reducedMotion) {

			this.drawStatic();
		} else {
			this.lastTime = performance.now();
			this.rafId = requestAnimationFrame(this.loop);
		}
	}

	stop() {
		this.running = false;
		if (this.rafId !== null) {
			cancelAnimationFrame(this.rafId);
			this.rafId = null;
		}
		window.removeEventListener("resize", this.handleResize);
		if (this.canvas) {
			this.canvas.remove();
			this.canvas = null;
		}
		this.ctx = null;
		this.flies = [];
	}

	private handleResize = () => {
		if (!this.canvas) return;
		this.canvas.width = this.width;
		this.canvas.height = this.height;
		if (this.reducedMotion) this.drawStatic();
	};

	private drawFirefly(f: Firefly, ctx: CanvasRenderingContext2D) {
		const glow = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r * 4);
		const c = this.config.hue;
		glow.addColorStop(0, `hsla(${c}, 100%, 88%, ${f.alpha})`);
		glow.addColorStop(0.25, `hsla(${c}, 95%, 70%, ${f.alpha * 0.55})`);
		glow.addColorStop(1, `hsla(${c}, 90%, 60%, 0)`);
		ctx.fillStyle = glow;
		ctx.beginPath();
		ctx.arc(f.x, f.y, f.r * 4, 0, Math.PI * 2);
		ctx.fill();

		ctx.fillStyle = `hsla(${c}, 100%, 95%, ${Math.min(1, f.alpha + 0.15)})`;
		ctx.beginPath();
		ctx.arc(f.x, f.y, f.r * 0.5, 0, Math.PI * 2);
		ctx.fill();
	}

	private drawStatic() {
		const ctx = this.ctx;
		if (!ctx || !this.canvas) return;
		ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
		for (const f of this.flies) {
			f.alpha = f.baseAlpha;
			this.drawFirefly(f, ctx);
		}
	}

	private loop = (now: number) => {
		if (!this.running || !this.ctx || !this.canvas) return;
		const dt = Math.min((now - this.lastTime) / 1000, 0.05);
		this.lastTime = now;
		this.elapsed += dt;

		const ctx = this.ctx;
		ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

		const w = this.canvas.width;
		const h = this.canvas.height;

		for (const f of this.flies) {

			f.x += f.vx * dt + Math.cos(this.elapsed * 0.8 + f.swayPhase) * f.swayAmp * dt;
			f.y += f.vy * dt + Math.sin(this.elapsed * 1.1 + f.swayPhase) * f.swayAmp * 0.5 * dt;

			f.alpha =
				f.baseAlpha *
				(0.45 + 0.55 * (0.5 + 0.5 * Math.sin(this.elapsed * f.twinkleSpeed + f.phase)));

			if (f.x < -20) f.x = w + 20;
			if (f.x > w + 20) f.x = -20;
			if (f.y < -20) f.y = h + 20;
			if (f.y > h + 20) f.y = -20;

			this.drawFirefly(f, ctx);
		}

		this.rafId = requestAnimationFrame(this.loop);
	};
}

let manager: FireflyEffect | null = null;

function initFirefly(enabled: boolean) {
	if (!manager) manager = new FireflyEffect(fireflyConfig);
	if (enabled) manager.start();
	else manager.stop();
}

(function setupFirefly() {
	if (window.fireflyInitialized) return;
	window.fireflyInitialized = true;

	const stored = localStorage.getItem("fireflyEnabled");
	const enabled = stored !== null ? stored === "true" : fireflyConfig.enable;
	initFirefly(enabled);

	window.addEventListener("fireflyToggle", (e: Event) => {
		const detail = (e as CustomEvent<{ enabled: boolean }>).detail;
		if (!detail) return;
		initFirefly(detail.enabled);
	});
})();
</script>
