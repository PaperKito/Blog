---
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";

interface Props {
	side: "left" | "right";
	position: "left" | "right" | "both";
	enable: boolean;
	hideSidebarOnPostPage: boolean;
	hasLeftComponents: boolean;
	hasRightComponents: boolean;
	sidebarClass: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
}

const {
	side,
	position,
	enable,
	hideSidebarOnPostPage,
	hasLeftComponents,
	hasRightComponents,
	sidebarClass,
	headings = [],
	encrypted = false,
} = Astro.props;

const staticId =
	side === "left" ? "left-sidebar-wrapper" : "right-sidebar-static";

const staticShown = position === "both" || position === side;
const hasComponents = side === "left" ? hasLeftComponents : hasRightComponents;

const staticSideBarSide =
	side === "left"
		? position === "both"
			? "left"
			: undefined
		: ("right" as const);
---

{staticShown &&
	(enable ? (
		<div
			id={staticId}
			data-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}
		>
			{hasComponents && (
				<SideBar
					side={staticSideBarSide}
					class={sidebarClass}
					headings={headings}
					encrypted={encrypted}
				/>
			)}
		</div>
	) : (
		<div id={staticId} class="hidden"></div>
	))}

{/* Swup 占位容器：始终存在（否则 Swup 会退化为整页加载），永远为空、不参与布局 */}
<div
	id={`${side}-sidebar-dynamic`}
	class="hidden transition-swup-fade"
	data-sidebar-placeholder="true"
></div>
